# Review paths and user before installing this unit.
[Unit]
Description=Terminal AI local-first agent web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terminal-ai
Group=terminal-ai
WorkingDirectory=/opt/terminal_ai
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/terminal_ai/.env
ExecStart=/opt/terminal_ai/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/terminal-ai /opt/terminal_ai/.env

[Install]
WantedBy=multi-user.target
