[Unit]
Description=Terminal AI local-first web agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_APP_DIR
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-REPLACE_APP_DIR/.env
ExecStart=REPLACE_APP_DIR/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=REPLACE_APP_DIR REPLACE_STATE_DIR
[Install]
WantedBy=multi-user.target
