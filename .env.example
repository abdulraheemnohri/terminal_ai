# Terminal AI environment template.
# Every key below is a FAKE placeholder. Replace only the providers you use
# in your private .env file. Never commit real API keys or tokens.

# Server: local-only is the safe default.
# TERMINAL_AI_HOST=127.0.0.1
# TERMINAL_AI_PORT=8000
# Remote binding is not recommended without authentication, TLS, CSRF/origin
# protections, rate limiting, and firewall rules. Set only as an explicit choice.
# TERMINAL_AI_ALLOW_REMOTE=0
# Optional HTTP Basic authentication. Set BOTH values to protect the dashboard,
# APIs and WebSocket events. Health probes /healthz and /readyz stay public.
# Use a long, unique password; do not use these fake placeholders as credentials.
# TERMINAL_AI_AUTH_USER=replace_with_your_username
# TERMINAL_AI_AUTH_PASSWORD=replace_with_a_long_random_password

# Provider credentials (fake placeholders only; uncomment and replace as needed).
GEMINI_API_KEY=replace_with_your_real_gemini_api_key
# OPENAI_API_KEY=replace_with_your_openai_api_key
# ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
# OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
# GROQ_API_KEY=replace_with_your_groq_api_key
# DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# TOGETHER_API_KEY=replace_with_your_together_api_key
# MISTRAL_API_KEY=replace_with_your_mistral_api_key
# XAI_API_KEY=replace_with_your_xai_api_key
# FIREWORKS_API_KEY=replace_with_your_fireworks_api_key
# CEREBRAS_API_KEY=replace_with_your_cerebras_api_key

# Optional Hugging Face token for gated model downloads.
# HF_TOKEN=replace_with_your_huggingface_token

# Optional backend configuration: auto, cloud, local, hybrid.
# TERMINAL_AI_MODE=auto

# Optional storage/model overrides.
# TERMINAL_AI_STATE=/path/to/private/terminal-ai-state
# TERMINAL_AI_MODELS=/path/to/private/terminal-ai-models
# TERMINAL_AI_GEMINI_MODEL=gemini-3.8-flash
# TERMINAL_AI_DEBUG=0

# Never place secrets in logs, source control, screenshots, or shared backups.
