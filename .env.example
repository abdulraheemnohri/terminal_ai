# terminal-ai environment file
# Copy this file to `.env` and fill in your keys.
# It is loaded automatically at startup (disable: /set env_autoload off)
# and is git-ignored. Secret-looking keys are masked in /env output.

# ── Cloud (Gemini) — required for cloud / hybrid / auto modes ──
GEMINI_API_KEY=

# ── Hugging Face — required for gated local models ──
HF_TOKEN=

# ── Optional overrides ──
# TERMINAL_AI_STATE=~/.terminal_ai     # state directory
# TERMINAL_AI_MODELS=~/terminal-ai/models  # local model directory
# TERMINAL_AI_DEBUG=1                   # verbose debug logging
# TERMINAL_AI_ENV=/path/to/.env        # force a specific .env file
