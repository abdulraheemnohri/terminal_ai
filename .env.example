# terminal-ai environment template
# IMPORTANT: All values marked FAKE are nonfunctional placeholders, NOT real credentials.
# Replace them with your own keys before using cloud features.
# Never commit your real .env file; .env is git-ignored.
# Secret-looking values are masked in /env output.

# ── Cloud (Gemini) — needed for cloud / hybrid / auto modes ──
# FAKE placeholder only; replace with a real Google AI Studio API key.
GEMINI_API_KEY=FAKE_GEMINI_API_KEY_REPLACE_ME_NOT_REAL

# ── Hugging Face — only needed for gated local models ──
# FAKE placeholder only; replace with a real Hugging Face access token if required.
HF_TOKEN=hf_FAKE_TOKEN_REPLACE_ME_NOT_REAL

# ── Optional overrides (uncomment and customize if needed) ──
# TERMINAL_AI_STATE=~/.terminal_ai
# TERMINAL_AI_MODELS=~/terminal-ai/models
# TERMINAL_AI_DEBUG=1
# TERMINAL_AI_ENV=/path/to/.env
