# terminal-ai environment template
# These values are intentionally FAKE examples and will NOT authenticate.
# Replace them in your private local .env file with your own credentials.
# Never commit your real .env file; .env is git-ignored.
# Secret-looking values are masked in /env output.

# Google Gemini API key (needed for cloud / hybrid / auto modes)
GEMINI_API_KEY=AIzaSyD_FAKE_GEMINI_KEY_NOT_REAL

# Hugging Face access token (optional; needed only for gated models)
HF_TOKEN=hf_FAKE_HUGGINGFACE_TOKEN_NOT_REAL

# Optional overrides (uncomment and customize if needed)
# TERMINAL_AI_STATE=~/.terminal_ai
# TERMINAL_AI_MODELS=~/terminal-ai/models
# TERMINAL_AI_DEBUG=1
# TERMINAL_AI_ENV=/path/to/.env
