# Terminal AI web application environment template
# These are placeholders only. Replace them in your private local .env file.
# Never commit real API keys or tokens.

# Required for Gemini cloud mode
GEMINI_API_KEY=replace_with_your_real_gemini_api_key

# Optional Hugging Face token for gated model downloads
HF_TOKEN=replace_with_your_huggingface_token

# Optional backend configuration: auto, cloud, local, hybrid
# TERMINAL_AI_MODE=auto

# Optional storage overrides
# TERMINAL_AI_STATE=/path/to/terminal-ai-state
# TERMINAL_AI_MODELS=/path/to/terminal-ai-models
# TERMINAL_AI_GEMINI_MODEL=gemini-3.8-flash
# TERMINAL_AI_DEBUG=1
